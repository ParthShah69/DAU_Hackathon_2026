# Local-only configuration. Copy this file to .env and replace the example
# password before starting PostgreSQL. Do not commit .env.
CARBONBRIDGE_DEMO_DB_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://carbonbridge_app:change-this-local-password@127.0.0.1:54329/carbonbridge_demo
PORT=8080
# Default keeps deterministic orchestration only. Set to ollama to enable the
# local, evidence-bounded response editor (no cloud or API key required).
ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=45000
DEMO_AUTH_ENABLED=true
