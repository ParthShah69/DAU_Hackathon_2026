{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonbridge.example/contracts/v2/capability-manifest.json",
  "title": "CarbonBridge manual and assistant capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "capabilities"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "manifest_version": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "manual_route", "read_tools", "write_tools", "risk_class", "manual_fallback"],
        "properties": {
          "key": { "type": "string" },
          "manual_route": { "type": "string" },
          "read_tools": { "type": "array", "items": { "type": "string" } },
          "write_tools": { "type": "array", "items": { "type": "string" } },
          "risk_class": { "type": "string", "enum": ["read", "private_draft", "reversible", "externally_visible", "commercial"] },
          "manual_fallback": { "type": "boolean" }
        }
      }
    }
  }
}
