{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carbonbridge.example/contracts/v2/sse-event.schema.json",
  "title": "CarbonBridge workflow SSE event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "workflow_id", "sequence", "type", "payload", "occurred_at"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "enum": ["step_started", "needs_input", "action_preview", "action_committed", "result_card", "failed", "completed"] },
    "payload": { "type": "object" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
